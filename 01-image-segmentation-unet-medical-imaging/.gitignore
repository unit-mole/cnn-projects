*.dcm
*.dicom
patient_data/
clinical_data/
phi/

# Keep safe public demo assets and committed model
!data/sample_images/**
!data/sample_masks/**
!models/unet_medical.keras
# Vercel local state
.vercel/

# Browser model is intentionally tracked
!web/tfjs_model/*.bin
!web/tfjs_model/*.json
